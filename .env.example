# Copy to .env and fill in JWT_SECRET. Every variable is required; the server refuses to start otherwise.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (1 on Render/Fly, 0 locally). Needed for correct client IPs.
TRUST_PROXY=0

# Must be a replica set: transactions do not work on a standalone mongod.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=lastseat
# Attempts per transaction before giving up with 503 (retries only on transient/write-conflict errors).
TXN_MAX_ATTEMPTS=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800
# true in production (HTTPS); false for http://localhost
COOKIE_SECURE=false

HACKATHON_SLUG=hack4hack-2026
HACKATHON_NAME=Hack4Hack 2026
MIN_TEAM_SIZE=2
MAX_TEAM_SIZE=4

INVITE_TTL_HOURS=72
# 10 random bytes = 80 bits of entropy
INVITE_CODE_BYTES=10

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
REDEEM_RATE_LIMIT_WINDOW_MS=600000
REDEEM_RATE_LIMIT_IP_MAX=30
REDEEM_RATE_LIMIT_USER_MAX=10

IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_SECONDS=30

SSE_HEARTBEAT_MS=25000
SSE_RETRY_MS=2000
SSE_REPLAY_BUFFER=1000

BOARD_PAGE_SIZE_DEFAULT=20
BOARD_PAGE_SIZE_MAX=50

SUGGEST_SKILL_WEIGHT=0.6
SUGGEST_TZ_WEIGHT=0.4
SUGGEST_SKILL_TARGET=3
SUGGEST_WORKDAY_HOURS=8
SUGGEST_LIMIT=10
SUGGEST_TEAM_POOL=200

# Used only by `npm run seed` and `npm run loadtest`
SEED_USERS=10000
SEED_TEAMS=2000
SEED_RANDOM_SEED=42
# Password shared by all seeded users, so you can log in as seed-00001@seed.invalid. Required by `npm run seed`.
SEED_PASSWORD=
LOADTEST_CONNECTIONS=100
LOADTEST_DURATION_SECONDS=20
LOADTEST_PORT=4100
