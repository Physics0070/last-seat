# Copy to .env and fill in JWT_SECRET. Every variable is required; the server refuses to start otherwise.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app, needed for correct client IPs behind per-IP rate limits:
# 0 locally, 1 on Fly, 3 on Render (measured: a loopback peer, Render's load balancer, then Cloudflare's edge).
# Too low and users share a bucket (the key becomes a proxy's address);
# too high and a client could spoof its address with an X-Forwarded-For header.
TRUST_PROXY=0

# Must be a replica set: transactions do not work on a standalone mongod.
# Use 127.0.0.1, not localhost: Node tries IPv6 (::1) first, and when mongod listens on IPv4 only every new
# pooled connection waits ~250 ms for the fallback. That alone made the load test 10x slower (see LOAD_TEST.md).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=lastseat
# Attempts per transaction before giving up with 503 (retries only on transient/write-conflict errors).
TXN_MAX_ATTEMPTS=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800
# true in production (HTTPS); false for http://localhost
COOKIE_SECURE=false

HACKATHON_SLUG=hack4hack-2026
HACKATHON_NAME=Hack4Hack 2026
MIN_TEAM_SIZE=2
MAX_TEAM_SIZE=4

INVITE_TTL_HOURS=72
# Random bytes per invite code; 16 (128 bits) is the minimum the server accepts
INVITE_CODE_BYTES=16

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Signups and logins per address per minute. High on purpose: a venue is one connection for hundreds of people.
AUTH_RATE_LIMIT_MAX=300
REDEEM_RATE_LIMIT_WINDOW_MS=600000
REDEEM_RATE_LIMIT_IP_MAX=30
REDEEM_RATE_LIMIT_USER_MAX=10

IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_SECONDS=30
# Events stay in the outbox this long so a client can replay what it missed, even across a server restart
EVENT_RETENTION_HOURS=24

SSE_HEARTBEAT_MS=25000
SSE_RETRY_MS=2000
SSE_REPLAY_BUFFER=1000
# A client further behind than the memory buffer replays from the outbox, up to this many events; beyond that it refetches
SSE_OUTBOX_REPLAY_MAX=5000

BOARD_PAGE_SIZE_DEFAULT=20
BOARD_PAGE_SIZE_MAX=50
# Serialized board pages are cached in memory and dropped on every team event; the TTL is only a backstop
# for other instances' writes. 0 disables the cache.
BOARD_CACHE_TTL_MS=1000
BOARD_CACHE_MAX_ENTRIES=500

SUGGEST_SKILL_WEIGHT=0.6
SUGGEST_TZ_WEIGHT=0.4
SUGGEST_SKILL_TARGET=3
SUGGEST_WORKDAY_HOURS=8
SUGGEST_LIMIT=10
SUGGEST_TEAM_POOL=200

# Used only by `npm run seed` and `npm run loadtest`
SEED_USERS=10000
SEED_TEAMS=2000
SEED_RANDOM_SEED=42
# Password shared by all seeded users, so you can log in as seed-00001@seed.invalid. Required by `npm run seed`.
SEED_PASSWORD=
LOADTEST_CONNECTIONS=100
LOADTEST_DURATION_SECONDS=20
LOADTEST_PORT=4100
LOADTEST_P95_TARGET_MS=200
